# Replace these before exposing ATLAS outside localhost.
ATLAS_SECRET_KEY=replace-with-a-long-random-secret
ATLAS_LOGIN_PASSWORD=replace-with-a-strong-login-password
ATLAS_USER_ROLES={"aegis-admin":"admin","treasurer":"accountant","president":"president","reviewer":"reviewer"}
ATLAS_MAX_UPLOAD_BYTES=52428800

PUBLIC_FRONTEND_BASE_URL=https://atlas.example.com
CORS_ORIGINS=https://atlas.example.com
ATLAS_DOMAIN=atlas.example.com
ATLAS_API_DOMAIN=api.atlas.example.com
ATLAS_DEFAULT_LEDGER_SHEET_URL=
ATLAS_DEFAULT_DUES_LEDGER_SHEET_URL=

# Optional: required for live Google Sheets/Drive integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
